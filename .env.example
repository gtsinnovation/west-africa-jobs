# ReliefWeb API — request a free appname at https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# Session signing secret for admin + user auth cookies — set a long random value in production
SESSION_SECRET=change-me-to-a-long-random-string

# Email delivery — leave unset to use the built-in dev outbox (viewable in the admin dashboard).
# Set these to enable real SMTP delivery of verification emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="West Africa Impact Jobs <no-reply@example.org>"
