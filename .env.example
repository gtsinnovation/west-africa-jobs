# ReliefWeb API — request a free appname at https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# Session signing secret for admin + user auth cookies — set a long random value in production
SESSION_SECRET=change-me-to-a-long-random-string

# Email delivery — priority order: AhaSend > generic SMTP > built-in dev outbox
# (viewable in the admin dashboard when neither is configured).

# Option A: AhaSend (https://ahasend.com) — recommended
AHASEND_API_KEY=
AHASEND_ACCOUNT_ID=
AHASEND_FROM_EMAIL=
AHASEND_FROM_NAME="West Africa Impact Jobs"

# Option B: generic SMTP (used only if AhaSend vars above are not set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="West Africa Impact Jobs <no-reply@example.org>"
